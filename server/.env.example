# Copy to server/.env for local use. On Vercel, add these in Project Settings -> Environment Variables.
# Neon pooled connection string (host contains "-pooler"), must end with ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
ADMIN_USERNAME=choose-a-username
# Use a long unique password (12+ characters)
ADMIN_PASSWORD=choose-a-strong-password
# Random string of 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
INVOICE_PREFIX=JMS
# Only needed if the front end is on a different domain than the API
CLIENT_ORIGIN=http://localhost:5180
# Optional: 24+ character token for the GST report links (/api/reports/daily, /api/reports/gst.xlsx). Leave empty to disable them.
REPORT_TOKEN=
